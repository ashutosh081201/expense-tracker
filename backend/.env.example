# Copy to .env and fill in real values. Never commit .env.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/moneymap
JWT_SECRET=<long-random-string>
# Local default. Render sets PORT itself, so don't set it there.
PORT=3000
# Email: set BREVO_API_KEY to send via Brevo's HTTPS API (needed on hosts
# that block SMTP, e.g. Render free). Otherwise Gmail SMTP is used.
GMAIL_USER=<you@gmail.com>
GMAIL_APP_PASSWORD=<gmail-app-password>
BREVO_API_KEY=
EMAIL_FROM=<verified-brevo-sender@example.com>
GEMINI_API_KEY=<gemini-api-key>
